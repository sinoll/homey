# Local environment configuration.
# Copy this file to .env and adjust as needed.
# In production, set environment variables via server or container configuration instead.
APP_ENV=dev
APP_DEBUG=true

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yii_cloud
DB_USER=root
DB_PASSWORD=

# Keep uploaded files outside the public web directory.
# Defaults to <project-root>/data/storage when unset.
# APP_STORAGE_PATH=
